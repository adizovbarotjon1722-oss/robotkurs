# Telegram: @BotFather dan olingan token
BOT_TOKEN=
# Serveringizning HTTPS manzili (oxirida / belgisisiz), masalan https://qumri.up.railway.app
PUBLIC_URL=
# Uzun tasodifiy satr (kamida 32 belgi). Telegram webhook so'rovlarini tekshirish uchun
WEBHOOK_SECRET=
# Suhbat uchun: ikkalasidan bittasi yetarli
# Claude (pullik, eng sifatli): console.anthropic.com
ANTHROPIC_API_KEY=
# Google Gemini (BEPUL): aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Qo'shimcha BEPUL AI lar (ixtiyoriy, qancha ko'p bo'lsa, shuncha ishonchli):
# Cerebras: cloud.cerebras.ai -> API Keys
CEREBRAS_API_KEY=
# OpenRouter (bepul ":free" modellar): openrouter.ai -> Keys
OPENROUTER_API_KEY=
# Mistral: console.mistral.ai -> API Keys (bepul "Experiment" tarifi)
MISTRAL_API_KEY=
# Qaysi AI birinchi ishlatilsin: anthropic, gemini, groq, cerebras, mistral, openrouter yoki openai.
# Biri ishlamasa (kredit yo'q, limit, internet), bot o'zi keyingisiga o'tadi. Groq kaliti suhbat uchun ham ishlaydi (bepul Llama).
AI_PROVIDER=
# Ovozni tanish (BEPUL): console.groq.com -> API Keys. Bo'lsa, OpenAI o'rniga ishlatiladi
GROQ_API_KEY=
# GROQ_CHAT_MODEL= (bo'sh qoldiring: server ishlaydigan modelni o'zi tanlaydi)
# Hamrohning jonli ovozi (pullik, ixtiyoriy): platform.openai.com. Bo'lmasa, Mini App brauzer ovozida gapiradi
OPENAI_API_KEY=
# Ixtiyoriy sozlamalar
CLAUDE_MODEL=claude-haiku-5-5
FREE_DAILY_AI=30
PREMIUM_DAILY_AI=400
PREMIUM_STARS=150
PREMIUM_DAYS=30
# Admin Telegram ID lari, vergul bilan (/admin buyrug'i uchun)
ADMIN_IDS=
# Reverse proxy ortida bo'lsa (Railway, Render) IP ni to'g'ri aniqlash uchun
TRUST_PROXY=1
# Kompyuterda ishlatganda port (band bo'lsa, server o'zi keyingisini topadi). Railway o'zi beradi.
# PORT=3478
DB_PATH=./server/data/qumri.db
